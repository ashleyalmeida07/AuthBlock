# WalletConnect Project ID (get from https://cloud.walletconnect.com/)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Database (PostgreSQL - NeonDB)
DATABASE_URL=your_neon_db_url_here

# Blockchain
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/your_infura_key
PRIVATE_KEY=your_private_key_for_contract_deployment

# Contract Addresses (deploy each contract and paste addresses here)
# CertificateRegistry — for marksheets
NEXT_PUBLIC_CONTRACT_ADDRESS=your_marksheet_contract_address
# QRScanLogger — for QR scan logging
NEXT_PUBLIC_QR_CONTRACT_ADDRESS=your_qr_contract_address
# DegreeRegistry — for final degree certificates
NEXT_PUBLIC_DEGREE_CONTRACT_ADDRESS=your_degree_contract_address
# CourseRegistry — for course/workshop certificates
NEXT_PUBLIC_COURSE_CONTRACT_ADDRESS=your_course_contract_address

# NextAuth (Auth.js)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_here

# Google OAuth (get from https://console.cloud.google.com)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Blockchain
ALCHEMY_RPC_URL="your_alchemy_rpc_url"

# OCR APIs (for scanned document verification)
# Get free OCR.space key (25,000 req/month): https://ocr.space/ocrapi/freekey
OCR_SPACE_API_KEY=your_ocr_space_api_key

# Optional: Google Cloud Vision (better accuracy, paid)
# Get key from: https://console.cloud.google.com/apis/credentials
GOOGLE_VISION_API_KEY=your_google_vision_api_key
